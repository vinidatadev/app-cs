# Arquivo de exemplo das variáveis de ambiente
# Copie para .env e preencha com seus valores

# Banco de Dados
POSTGRES_PASSWORD=senha_super_segura_aqui

# JWT (Backend)
SECRET_KEY=chave-secreta-jwt-com-minimo-32-caracteres-bem-aleatorios

# Azure AD (Microsoft Login)
AZURE_CLIENT_ID=seu-client-id-do-azure
AZURE_CLIENT_SECRET=seu-client-secret-do-azure
AZURE_TENANT_ID=seu-tenant-id-do-azure
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

# CORS (adicione IPs necessários separados por vírgula)
CORS_ORIGINS=http://localhost:3000,http://10.0.103.20:3000

# Frontend
VITE_BACKEND_URL=http://localhost:8000
VITE_AZURE_CLIENT_ID=seu-client-id-do-azure
VITE_AZURE_TENANT_ID=seu-tenant-id-do-azure
